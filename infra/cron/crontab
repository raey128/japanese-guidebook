# Weekly open-data dump, Mondays 03:00 UTC. Same entrypoint as `make dump`.
0 3 * * 1 cd /app/backend && python -m app.cli dump --out /app/dumps
# Weekly usage-event rollup + 90-day expiry (R18.3), Mondays 03:30 UTC.
30 3 * * 1 cd /app/backend && python -m app.cli rollup-events
# Wikimedia photos for new places (and a recheck of misses after 90 days), Tuesdays 04:00.
0 4 * * 2 cd /app/backend && python -m app.cli fetch-place-images --limit 500
